    Layout = "_Customer";
}
<h1>Customer View</h1>
 <div id="ItemCard" class="card-deck">
    @* <div class="card">
        <img src="/@product.Image" class="card-img-top" alt="..." style="width:150px;height:150px">
        <div class="card-body">
            <h5 class="card-title">@product.ProductName</h5>
            <p class="card-text">This is a longer card with supporting text below as a natural lead-in to additional content. This content is a little bit longer.</p>
            <p class="card-text"><small class="text-muted">@product.Price</small></p>
            <a href="AddItemToCart/@product.ProductId" class="btn btn-primary"><bold>Add To Cart</bold></a>
