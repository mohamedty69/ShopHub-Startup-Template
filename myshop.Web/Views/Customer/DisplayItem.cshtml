@model List<CartItem>
@{
    Layout = "_Customer";
}
<a href="/Customer/DeleteCustomerCart" class="btn btn-danger alert-danger">Delete Cart</a>
@foreach(var product in Model)
{   
<div class="card-deck">
    <div class="card">
        <img src="/@product.ImgUrl" class="card-img-top" alt="..." style="width:150px;height:150px">
        <div class="card-body">
            <h5 class="card-title">@product.ProductName</h5>
            <p class="card-text">@product.Description</p>
            <p class="card-text">Price:<small class="text-muted">@product.TotalPrice</small></p>
            <p>Quantity: <b>@product.Quantity</b></p>
            <a href="/Customer/IncreaseItem/@product.ProductId" class="btn btn-success btn-warning">
                <i class="fa-solid fa-google-plus-square">+</i>
            </a>
            <a href="/Customer/DecreaseItem/@product.ProductId" class="btn btn-success btn-warning">
                    <i class="fa-solid fa-google-plus-square">-</i>
            </a>
            <a href="/Customer/RemoveItem/@product.ProductId" class="btn btn-danger btn-sm">
                <i class="fa-solid fa-trash">Delete</i>
            </a>
        </div>
    </div>
</div>
}
@section Scripts{
    <script>
        function GetProducts(){
            $.ajax()
        }
    </script>
}