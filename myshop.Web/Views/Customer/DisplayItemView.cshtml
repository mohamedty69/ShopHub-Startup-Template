                                                <button onclick="DecreaseItem(${res.productId})" class="btn btn-outline-secondary rounded-circle btn-sm d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; padding: 0;">
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                                <span class="fw-bold mx-3">${res.quantity}</span>
                                                <button onclick="IncreaseItem(${res.productId})" class="btn btn-primary rounded-circle btn-sm d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; padding: 0;">
                                                    <i class="bi bi-plus-lg"></i>
                                                </button>
                                            </div>
