@{
    Layout = "_Customer";
}
<a href="/Customer/DeleteCustomerCart" class="btn btn-danger alert-danger">Delete Cart</a>
<h2 id ="totalprice"></h2> 
<button onclick="DisplayItems()" accesskey="" class="btn btn-success">Display Items</button>
<div id="DisplayItems" class="card-deck">
  
</div>
@section Scripts {
    <script>
        function DisplayItems()
        {
            $.ajax(
                {
                    url : "/Customer/DisplayItem",
                    method : "GET",
                    success: function(result){
                        console.log(result);
                        for(product of result)
                        {
                            document.getElementById("DisplayItems").innerHTML+=
                               `
                               <div class="card">
                                    <img src="/${product.imgUrl}" class="card-img-top" alt="..." style="width:150px;height:150px">
                                    <div class="card-body">
                                        <h5 class="card-title">${product.productName}</h5>
                                        <p class="card-text">${product.description}</p>
                                        <p class="card-text">Price:<small class="text-muted">${product.totalPrice}</small></p>
                                        <p>Quantity: <b>${product.quantity}</b></p>
                                            <button onclick="IncreaseItem(${product.productId})" class="btn btn-success btn-warning">
                                            <i class="fa-solid fa-google-plus-square">+</i>
                                        </button>
                                        <button onclick="DecreaseItem(${product.productId})" class="btn btn-success btn-warning">
                                                <i class="fa-solid fa-google-plus-square">-</i>
                                        </button>
                                        <button onclick="RemoveItem(${product.productId})" class="btn btn-danger btn-sm">
                                            <i class="fa-solid fa-trash">Delete</i>
                                        </button>
                                    </div>
                                </div>
                               `
                        }
                    }
                }
            );
        }
        function IncreaseItem(productId)
        {
            $.ajax(
                {
                    url : "/Customer/IncreaseItem",
                    method : "POST",
                    data : {productId : productId},
                    success : function(response){  
                        console.log("Data Saved", response);
                        for(res of response)
                        {
                            document.getElementById("DisplayItems").innerHTML+=
                               `
                               <div class="card">
                                    <img src="/${res.imgUrl}" class="card-img-top" alt="..." style="width:150px;height:150px">
                                    <div class="card-body">
                                        <h5 class="card-title">${res.productName}</h5>
                                        <p class="card-text">${res.description}</p>
                                        <p class="card-text">Price:<small class="text-muted">${res.totalPrice}</small></p>
                                        <p>Quantity: <b>${res.quantity}</b></p>
                                            <button onclick="IncreaseItem(${res.productId})" class="btn btn-success btn-warning">
                                            <i class="fa-solid fa-google-plus-square">+</i>
                                        </button>
                                        <button onclick="DecreaseItem(${res.productId})" class="btn btn-success btn-warning">
                                                <i class="fa-solid fa-google-plus-square">-</i>
                                        </button>
                                        <button onclick="RemoveItem(${res.productId})" class="btn btn-danger btn-sm">
                                            <i class="fa-solid fa-trash">Delete</i>
                                        </button>
                                    </div>
                                </div>
                               `
                        }
                    }
                }
            );
        }
        function DecreaseItem(productId)
        {
            $.ajax(
                {
                    url : "/Customer/DecreaseItem",
                    method : "POST",
                    data : {productId : productId},
                    success : function(response){
                        let res = response;
                        console.log("Data Saved", response);
                    }
                }
            );
        }
                function RemoveItem(productId)
        {
            $.ajax(
                {
                    url : "/Customer/RemoveItem",
                    method : "POST",
                    data : {productId : productId},
                    success : function(response){
                        let res = response;
                        console.log("Data Saved", response);
                    }
                }
            );
        }
    </script>
}