                                        <button onclick="RemoveItem(${res.productId})" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2 rounded-circle shadow-sm d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; padding: 0; z-index: 2;" title="Remove Item">
