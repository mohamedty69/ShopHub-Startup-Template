                                            <div class="d-flex justify-content-between align-items-end mt-3 mb-3 pb-3 border-bottom border-light">
                                                <div>
                                                    <span class="text-muted small d-block">Price</span>
                                                    <span class="fw-bold text-dark">$${res.price}</span>
                                                </div>
                                                <div class="text-end">
                                                    <span class="text-muted small d-block">Total</span>
                                                    <span class="price-tag mb-0" style="font-size: 1.2rem;">$${res.totalPrice}</span>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mt-auto bg-light rounded-pill p-1">
                                                <button onclick="DecreaseItem(${res.productId})" class="btn btn-outline-secondary rounded-circle btn-sm d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; padding: 0;">
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                                <span class="fw-bold mx-3">${res.quantity}</span>
                                                <button onclick="IncreaseItem(${res.productId})" class="btn btn-primary rounded-circle btn-sm d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; padding: 0;">
                                                    <i class="bi bi-plus-lg"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                               `
                        }
                      document.getElementById("totalprice").innerHTML = ""
                      document.getElementById("totalprice").innerHTML+= `Total order price: <b>${totalOrderPrice}</b>`
                    }
                }
            );
        }
