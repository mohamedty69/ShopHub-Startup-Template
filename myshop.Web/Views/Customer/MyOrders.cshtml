@model IEnumerable<myshop.BLL.DTOs.Order.SummaryOrderDTO>
@using myshop.DAL.Enum
@{
    Layout = "_Customer";
    ViewData["Title"] = "My Orders";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-transparent p-0">
            <li class="breadcrumb-item">
                <a href="/Customer/DisplayProducts" class="text-decoration-none text-primary">
                    <i class="bi bi-shop me-1"></i> Home
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">My Orders</li>
        </ol>
    </nav>

    <!-- Page Header Banner -->
    <div class="custom-card mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="mb-1" style="color: #1e3a8a; font-weight: 700;">
                <i class="bi bi-box-seam me-2"></i> My Orders & Purchase History
            </h2>
            <p class="text-muted mb-0">Track and review all your past and current purchases with AuraShop</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/Customer/DisplayProducts" class="btn btn-primary shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-cart-plus"></i>
                <span>Continue Shopping</span>
            </a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- Empty State Card -->
        <div class="custom-card text-center py-5">
            <div class="mb-4">
                <div class="d-inline-flex justify-content-center align-items-center rounded-circle bg-primary bg-opacity-10 p-4" style="width: 100px; height: 100px;">
                    <i class="bi bi-bag-x text-primary" style="font-size: 3rem;"></i>
                </div>
            </div>
            <h3 class="fw-bold text-dark mb-2">No Orders Placed Yet</h3>
            <p class="text-muted mx-auto mb-4" style="max-width: 480px;">
                You haven't placed any orders with us so far. Discover our wide range of premium products and get your first order delivered right to your doorstep!
            </p>
            <a href="/Customer/DisplayProducts" class="btn btn-primary btn-lg shadow px-4 py-2">
                <i class="bi bi-grid me-2"></i> Explore Products
            </a>
        </div>
    }
    else
    {
        <!-- Summary Stats Cards -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-lg-4">
                <div class="p-3 bg-white rounded-3 border shadow-sm d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 p-3 text-primary d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                        <i class="bi bi-receipt fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Total Orders</div>
                        <div class="fs-4 fw-bold text-dark">@Model.Count()</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="p-3 bg-white rounded-3 border shadow-sm d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success bg-opacity-10 p-3 text-success d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                        <i class="bi bi-cash-stack fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Total Spent</div>
                        <div class="fs-4 fw-bold text-success">$@Model.Sum(o => o.TotalPrice).ToString("N2")</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-lg-4">
                <div class="p-3 bg-white rounded-3 border shadow-sm d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-warning bg-opacity-10 p-3 text-warning d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                        <i class="bi bi-truck fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Active Orders</div>
                        <div class="fs-4 fw-bold text-dark">@Model.Count(o => o.OrderStatus != OrderStatus.Delivered)</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Orders List -->
        <div class="d-flex flex-column gap-4 pb-5">
            @foreach (var order in Model.OrderByDescending(o => o.OrderDate))
            {
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden order-card">
                    <!-- Order Card Header -->
                    <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px;">
                                <i class="bi bi-bag-check fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark fs-5">Order #@order.Id</div>
                                <div class="text-muted small">
                                    <i class="bi bi-calendar3 me-1"></i> Placed on @order.OrderDate.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3">
                            <!-- Status Badge -->
                            @switch (order.OrderStatus)
                            {
                                case OrderStatus.Pending:
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-semibold shadow-sm">
                                        <i class="bi bi-hourglass-split me-1"></i> Pending
                                    </span>
                                    break;
                                case OrderStatus.Processing:
                                    <span class="badge bg-info text-dark px-3 py-2 rounded-pill fw-semibold shadow-sm">
                                        <i class="bi bi-arrow-repeat me-1"></i> Processing
                                    </span>
                                    break;
                                case OrderStatus.Shipped:
                                    <span class="badge bg-primary px-3 py-2 rounded-pill fw-semibold shadow-sm">
                                        <i class="bi bi-truck me-1"></i> Shipped
                                    </span>
                                    break;
                                case OrderStatus.Delivered:
                                    <span class="badge bg-success px-3 py-2 rounded-pill fw-semibold shadow-sm">
                                        <i class="bi bi-check-circle-fill me-1"></i> Delivered
                                    </span>
                                    break;
                                default:
                                    <span class="badge bg-secondary px-3 py-2 rounded-pill fw-semibold shadow-sm">
                                        @order.OrderStatus
                                    </span>
                                    break;
                            }
                        </div>
                    </div>

                    <!-- Order Card Body -->
                    <div class="card-body p-3 p-md-4">
                        <div class="row g-4">
                            <!-- Items List -->
                            <div class="col-lg-8">
                                <h6 class="fw-bold text-dark mb-3">
                                    <i class="bi bi-cart3 me-1 text-primary"></i> Purchased Items (@(order.Items?.Count() ?? 0))
                                </h6>

                                @if (order.Items != null && order.Items.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-borderless align-middle mb-0">
                                            <thead class="bg-light text-muted small text-uppercase">
                                                <tr>
                                                    <th style="border-radius: 8px 0 0 8px;">Product</th>
                                                    <th class="text-center">Qty</th>
                                                    <th class="text-end">Unit Price</th>
                                                    <th class="text-end" style="border-radius: 0 8px 8px 0;">Total</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in order.Items)
                                                {
                                                    <tr class="border-bottom border-light">
                                                        <td class="py-3">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="p-2 bg-light rounded-3 text-primary">
                                                                    <i class="bi bi-box"></i>
                                                                </div>
                                                                <span class="fw-semibold text-dark">@item.ProductName</span>
                                                            </div>
                                                        </td>
                                                        <td class="text-center py-3">
                                                            <span class="badge bg-light text-dark border px-2 py-1">@item.Count</span>
                                                        </td>
                                                        <td class="text-end text-muted py-3">
                                                            $@item.Price.ToString("N2")
                                                        </td>
                                                        <td class="text-end fw-bold text-dark py-3">
                                                            $@((item.Price * item.Count).ToString("N2"))
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-light border small text-muted">
                                        No item details available for this order.
                                    </div>
                                }
                            </div>

                            <!-- Shipping & Cost Summary -->
                            <div class="col-lg-4">
                                <div class="p-3 bg-light rounded-4 border h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <h6 class="fw-bold text-dark mb-3">
                                            <i class="bi bi-geo-alt me-1 text-primary"></i> Delivery Details
                                        </h6>
                                        <div class="small text-secondary mb-2">
                                            <strong class="text-dark d-block">Recipient:</strong>
                                            @(string.IsNullOrEmpty(order.Name) ? "Customer" : order.Name)
                                        </div>
                                        <div class="small text-secondary mb-3">
                                            <strong class="text-dark d-block">Shipping Address:</strong>
                                            @order.Address, @order.City
                                        </div>
                                        <div class="small text-secondary mb-3">
                                            <strong class="text-dark d-block">Payment Status:</strong>
                                            <span class="badge bg-success bg-opacity-10 text-success fw-semibold">
                                                @(string.IsNullOrEmpty(order.PaymentStatus) ? "Paid" : order.PaymentStatus)
                                            </span>
                                        </div>
                                    </div>

                                    <div class="pt-3 border-top mt-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-bold text-dark">Order Total:</span>
                                            <span class="price-tag fs-4 fw-bold text-success mb-0">$@order.TotalPrice.ToString("N2")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .order-card {
        border: 1px solid #e2e8f0;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .order-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08) !important;
        border-color: #cbd5e1;
    }
</style>
