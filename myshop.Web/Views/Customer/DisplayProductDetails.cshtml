@model myshop.BLL.DTOs.Product.Customer.DisplayProductDetailsDTO
@{
    Layout = "_Customer";
    ViewData["Title"] = Model?.ProductName ?? "Product Details";
}

<div class="container py-4">
    <!-- Breadcrumb & Back button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 bg-transparent p-0">
                <li class="breadcrumb-item"><a href="/Customer/DisplayProducts" class="text-decoration-none text-primary"><i class="bi bi-arrow-left me-1"></i> Back to Products</a></li>
                <li class="breadcrumb-item active text-truncate" style="max-width: 300px;" aria-current="page">@Model?.ProductName</li>
            </ol>
        </nav>
        <a href="/Customer/DisplayItemView" class="btn btn-outline-primary shadow-sm btn-sm d-flex align-items-center">
            <i class="bi bi-cart3 me-1"></i> View Cart
        </a>
    </div>

    <!-- Product Showcase Card -->
    <div class="custom-card mb-4">
        <div class="row g-4 align-items-center">
            <!-- Product Image -->
            <div class="col-md-5 text-center">
                <div class="p-3 bg-light rounded-4 border shadow-sm d-flex justify-content-center align-items-center" style="min-height: 320px;">
                    <img src="/@Model?.Image" alt="@Model?.ProductName" class="img-fluid rounded-3" style="max-height: 280px; object-fit: contain;" onerror="this.src='/images/placeholder.png'; this.onerror=null;">
                </div>
            </div>

            <!-- Product Details Info -->
            <div class="col-md-7">
                <div class="ps-md-3">
                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill mb-2 fw-semibold">
                        <i class="bi bi-tag-fill me-1"></i> AuraShop Premium Item
                    </span>
                    <h2 class="fw-bold mb-2 text-dark">@Model?.ProductName</h2>

                    <!-- Star Rating Summary -->
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="text-warning fs-5">
                            @{
                                double avg = Model?.avgRating ?? 0;
                                int fullStars = (int)avg;
                                bool hasHalfStar = (avg - fullStars) >= 0.5;
                                int emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
                            }
                            @for (int i = 0; i < fullStars; i++)
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            @if (hasHalfStar)
                            {
                                <i class="bi bi-star-half"></i>
                            }
                            @for (int i = 0; i < emptyStars; i++)
                            {
                                <i class="bi bi-star"></i>
                            }
                        </div>
                        <span class="fw-bold text-dark fs-6">@avg.ToString("0.0")</span>
                        <span class="text-muted small">(@(Model?.reviewCount ?? 0) @((Model?.reviewCount == 1) ? "review" : "reviews"))</span>
                    </div>

                    <div class="price-tag mb-3" style="font-size: 2rem;">$@Model?.Price</div>

                    <p class="text-secondary mb-4 lh-base" style="font-size: 1.05rem;">
                        This is a premium product available in our store. Check it out and add it to your cart.
                    </p>

                    <hr class="my-4 text-muted opacity-25">

                    <!-- Actions -->
                    <div class="d-flex flex-wrap gap-3 align-items-center">
                        <button onclick="AddItem(@Model?.ProductId)" class="btn btn-success shadow px-4 py-2 d-flex align-items-center gap-2">
                            <i class="bi bi-cart-plus fs-5"></i>
                            <span class="fw-bold">Add to Cart</span>
                        </button>
                        <a href="/CheckOut/CheckOut" class="btn btn-primary shadow px-4 py-2 d-flex align-items-center gap-2">
                            <i class="bi bi-credit-card fs-5"></i>
                            <span>Buy Now</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reviews Section -->
    <div class="row g-4">
        <!-- Left: Write a Review Form -->
        <div class="col-lg-5">
            <div class="custom-card h-100">
                <div class="custom-card-header mb-4">
                    <i class="bi bi-pencil-square me-2"></i> Write a Review
                </div>

                <form action="/Review/AddReview" method="post" id="addReviewForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model?.ProductId" />

                    <!-- Interactive Star Rating Picker -->
                    <div class="mb-3 text-center p-3 bg-light rounded-3 border">
                        <label class="form-label d-block text-secondary fw-semibold mb-2">Your Rating</label>
                        <div class="star-rating d-inline-flex flex-row-reverse justify-content-center gap-1">
                            <input type="radio" id="star5" name="rating" value="5" class="d-none" required />
                            <label for="star5" class="star-label bi bi-star-fill fs-3 text-muted" title="5 Stars"></label>

                            <input type="radio" id="star4" name="rating" value="4" class="d-none" />
                            <label for="star4" class="star-label bi bi-star-fill fs-3 text-muted" title="4 Stars"></label>

                            <input type="radio" id="star3" name="rating" value="3" class="d-none" />
                            <label for="star3" class="star-label bi bi-star-fill fs-3 text-muted" title="3 Stars"></label>

                            <input type="radio" id="star2" name="rating" value="2" class="d-none" />
                            <label for="star2" class="star-label bi bi-star-fill fs-3 text-muted" title="2 Stars"></label>

                            <input type="radio" id="star1" name="rating" value="1" class="d-none" />
                            <label for="star1" class="star-label bi bi-star-fill fs-3 text-muted" title="1 Star"></label>
                        </div>
                        <div id="ratingText" class="text-muted small mt-1">Select rating</div>
                    </div>

                    <!-- Comment Textarea -->
                    <div class="mb-3">
                        <label for="comment" class="form-label">Your Review / Feedback</label>
                        <textarea class="form-control" id="comment" name="comment" rows="4" maxlength="500" placeholder="What did you like or dislike about this product?" required></textarea>
                        <div class="d-flex justify-content-end text-muted small mt-1">
                            <span id="charCount">0</span>/500 characters
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 shadow-sm py-2 d-flex justify-content-center align-items-center gap-2">
                        <i class="bi bi-send-fill"></i>
                        <span>Submit Review</span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Right: Customer Reviews List -->
        <div class="col-lg-7">
            <div class="custom-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <h4 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-chat-quote-fill me-2 text-primary"></i>Customer Reviews
                    </h4>
                    <span class="badge bg-secondary rounded-pill px-3 py-2">
                        @(Model?.Reviews?.Count() ?? 0) Reviews
                    </span>
                </div>

                @if (Model?.Reviews == null || !Model.Reviews.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <div class="mb-3">
                            <i class="bi bi-chat-square-text text-primary text-opacity-50" style="font-size: 3.5rem;"></i>
                        </div>
                        <h5 class="fw-semibold text-dark">No reviews yet</h5>
                        <p class="small text-muted mb-0">Be the first to share your thoughts on this product!</p>
                    </div>
                }
                else
                {
                    <div class="review-list d-flex flex-column gap-3" style="max-height: 520px; overflow-y: auto; padding-right: 4px;">
                        @foreach (var review in Model.Reviews)
                        {
                            <div class="p-3 rounded-3 border bg-light shadow-sm review-card transition-hover">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 38px; height: 38px;">
                                            <i class="bi bi-person-fill fs-5"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark small">Customer Review</div>
                                            <div class="text-muted" style="font-size: 0.75rem;">
                                                <i class="bi bi-clock me-1"></i>@review.CreatedAt.ToString("MMM dd, yyyy")
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-warning small">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            if (s <= review.rating)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-muted opacity-50"></i>
                                            }
                                        }
                                    </div>
                                </div>
                                <p class="text-secondary small mb-0 lh-base">
                                    @review.comment
                                </p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Star Rating Selector Styles */
    .star-rating .star-label {
        cursor: pointer;
        transition: color 0.2s ease, transform 0.2s ease;
    }

    .star-rating input:checked ~ label,
    .star-rating label:hover,
    .star-rating label:hover ~ label {
        color: #f59e0b !important;
        transform: scale(1.1);
    }

    .review-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .review-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(0,0,0,0.06);
    }

    .review-list::-webkit-scrollbar {
        width: 6px;
    }

    .review-list::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 4px;
    }
</style>

@section Scripts {
    <script>
        // Character count for review textarea
        $('#comment').on('input', function() {
            $('#charCount').text($(this).val().length);
        });

        // Dynamic star text feedback
        const ratingTexts = {
            '1': '⭐ Poor (1/5)',
            '2': '⭐⭐ Fair (2/5)',
            '3': '⭐⭐⭐ Good (3/5)',
            '4': '⭐⭐⭐⭐ Very Good (4/5)',
            '5': '⭐⭐⭐⭐⭐ Excellent (5/5)'
        };

        $('.star-rating input').on('change', function() {
            const val = $(this).val();
            $('#ratingText').text(ratingTexts[val] || 'Select rating').addClass('text-warning fw-bold').removeClass('text-muted');
        });

        // Add to Cart AJAX handler
        function AddItem(productId) {
            $.ajax({
                url: "/Customer/AddItemToCart",
                method: "POST",
                data: { productId: productId },
                success: function(response) {
                    let cartBadge = document.getElementById('cart-count');
                    if (cartBadge) {
                        let currentCount = parseInt(cartBadge.innerText) || 0;
                        cartBadge.innerText = currentCount + 1;
                    }
                    alert("Product successfully added to your cart!");
                },
                error: function(error) {
                    console.log("Error Occurred", error);
                    alert("Could not add product to cart.");
                }
            });
        }
    </script>
}
