@{
    ViewData["Title"] = "Display Users"; 
}
@model IEnumerable<DisplayUserDTO>
<style>
    table {
        border-collapse: collapse;
        width: 100%;
        border-block-end: 1px solid rgb(0,0,0);        
    }
</style >
<h1>Display All Users</h1>

<table class="table table-dark table-hover">
    <thead>
        <tr>   
        <td>Name</td>
        <td>User Name</td>
        <td>Email</td>
        <td>Phone Number</td>
        <td>City</td>
        <td>Address</td>
        <td>Lock Account</td>
        <td>Edit</td>
        <td>Delete</td>
        </tr>
    </thead>
        @foreach (DisplayUserDTO user in Model)
        {
        <tr>
            <td>
                @user.Name
            </td>
            <td>
                @user.UserName
            </td>
            <td>
                @user.Email
            </td>
            <td>
                @user.PhoneNumber
            </td>
            <td>
                @user.City
            </td>
            <td>
                @user.Address
            </td>
            @if(!user.IsLocked)
            {
                <td>
                    Not Locked
                </td>
            }
            else
            {
                <td>
                    Locked
                </td>
            }
            <td>
                <a href="/Home/EditUser/@user.UserID" class="btn btn-secondary" >Edit</a>
            </td>
            <td>
                <a href="/Home/DeleteUser/@user.UserID" class="btn btn-secondary">Delete</a>
            </td>
        </tr>
        }
</table>