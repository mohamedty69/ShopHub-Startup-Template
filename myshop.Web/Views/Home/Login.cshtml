@{
    Layout = "_Layout";
    ViewData["Title"] = "Login";
}
@model LoginDTO

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="custom-card text-center mb-4">
                <div class="mb-3">
                    <i class="fa-solid fa-circle-user" style="font-size: 4rem; color: #1e3a8a;"></i>
                </div>
                <h2 class="fw-bold" style="color: #1e3a8a;">Welcome Back</h2>
                <p class="text-muted">Login to your account to continue</p>
            </div>

            <div class="custom-card">
                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold"></label>
                        <input asp-for="Password" class="form-control" placeholder="Enter your password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-4 form-check d-flex align-items-center">
                        <input type="checkbox" asp-for="IsPersistent" class="form-check-input me-2" id="rememberMe" />
                        <label asp-for="IsPersistent" class="form-check-label text-muted" for="rememberMe">Remember me</label>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button asp-action="LoginUser" type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm">
                            <i class="fa-solid fa-right-to-bracket me-2"></i> Login
                        </button>
                    </div>
                    
                    <div class="text-center mt-4">
                        <p class="text-muted mb-0">Don't have an account?</p>
                        <a asp-controller="Home" asp-action="Register" class="text-decoration-none fw-bold" style="color: #3b82f6;">Register here</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
