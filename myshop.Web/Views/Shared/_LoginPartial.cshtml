@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav d-flex align-items-center gap-2">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a id="manage" class="nav-link fw-bold d-flex align-items-center" style="color: #1e3a8a !important;" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                <i class="bi bi-person-circle me-1 fs-5"></i>
                <span class="d-none d-md-inline">Hello @UserManager.GetUserName(User)!</span>
            </a>
        </li>
        <li class="nav-item">
            <form id="logoutForm" class="d-inline" asp-area="" asp-controller="Home" asp-action="LogOut">
                <button id="logout" type="submit" class="btn btn-outline-danger btn-sm px-3 rounded-pill fw-bold">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-outline-primary btn-sm px-3 rounded-pill fw-bold" id="register" asp-controller="Home" asp-action="Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-primary btn-sm px-3 rounded-pill fw-bold shadow-sm" id="login" asp-controller="Home" asp-action="Login">Login</a>
        </li>
    }
</ul>
