@model myshop.BLL.DTOs.Order.CheckOutOrderDTO
@{
    ViewData["Title"] = "Checkout";
}

<div class="container mt-5">
    <div class="row">
        <!-- Left Side: Order Summary -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0" style="border-radius: 15px;">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h4 class="mb-0 text-primary fw-bold"><i class="bi bi-cart-check"></i> Order Summary</h4>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- We assume you pass the CartItems in the ViewBag from your controller -->
                                @if (ViewBag.CartItems != null)
                                {
                                    decimal grandTotal = 0;
                                    foreach (var item in ViewBag.CartItems)
                                    {
                                        grandTotal += item.TotalPrice;
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="ms-2">
                                                        <h6 class="mb-0">@item.ProductName</h6>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end">@item.Price.ToString("C")</td>
                                            <td class="text-end fw-bold">@item.TotalPrice.ToString("C")</td>
                                        </tr>
                                    }
                                    <tr class="table-primary">
                                        <td colspan="3" class="text-end fw-bold fs-5">Grand Total:</td>
                                        <td class="text-end fw-bold fs-5">@grandTotal.ToString("C")</td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">Your cart is empty.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Delivery Details Form -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0" style="border-radius: 15px;">
                <div class="card-header bg-primary text-white pt-4 pb-3" style="border-radius: 15px 15px 0 0;">
                    <h4 class="mb-0"><i class="bi bi-truck"></i> Delivery Information</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-controller="CheckOut" asp-action="PlaceOrder">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold text-secondary">Full Name</label>
                            <input asp-for="Name" class="form-control form-control-lg" placeholder="John Doe" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-bold text-secondary">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control form-control-lg" placeholder="+1 (555) 000-0000" required />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="City" class="form-label fw-bold text-secondary">City</label>
                            <input asp-for="City" class="form-control form-control-lg" placeholder="New York" required />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Address" class="form-label fw-bold text-secondary">Detailed Address</label>
                            <textarea asp-for="Address" class="form-control form-control-lg" rows="3" placeholder="123 Main St, Apt 4B" required></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg" style="border-radius: 10px;">
                                <i class="bi bi-credit-card me-2"></i> Place Order & Pay
                            </button>
                            <a href="/Customer/DisplayProducts" class="btn btn-outline-secondary btn-lg" style="border-radius: 10px;">
                                <i class="bi bi-arrow-left me-2"></i> Back to Shop
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
