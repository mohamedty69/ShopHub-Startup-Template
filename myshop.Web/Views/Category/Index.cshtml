@model IEnumerable<CategoryDTO>

@{
    ViewBag.PageTitle = "Category Management";
    ViewBag.CardTitle = "View Categories";
}

<!-- Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />



<div class="custom-card">

    <div class="custom-card-header">
        <h4><i class="fa-solid fa-folder-open me-2"></i> @ViewBag.CardTitle</h4>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <a class="btn btn-primary" href="/Category/Create">
            <i class="fa-solid fa-circle-plus me-1"></i> Create Category
        </a>
    </div>

    <table class="table-custom">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Date Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@Html.Raw(item.Description)</td>
                    <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        <a class="btn btn-outline-primary btn-sm me-2" href="/Category/Edit/@item.Id">
                            <i class="fa-solid fa-pen-to-square"></i> Edit
                        </a>
                        <a class="btn btn-outline-danger btn-sm" href="/Category/Delete/@item.Id">
                            <i class="fa-solid fa-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
